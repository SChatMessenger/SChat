# Mobile config. Copy to `.env` — Expo auto-loads it and inlines every
# EXPO_PUBLIC_* variable into the JS bundle at build time (so it is NOT secret;
# never put keys here — those live in the device secure store via the Rust FFI).

# Where the app reaches the relay (services/api/client.ts).
EXPO_PUBLIC_API_URL=http://localhost:8080
# Android emulator → http://10.0.2.2:8080
# Physical device   → http://<your-LAN-IP>:8080  (same Wi-Fi as the relay)
